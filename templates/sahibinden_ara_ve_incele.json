{
  "name": "sahibinden_ara_ve_incele",
  "description": "Sahibinden'de arama yap, ilk 3 ilanı aç, fotoğrafları listele",
  "site": "www.sahibinden.com",
  "params": ["arama_terimi"],
  "steps": [
    { "do": "navigate", "url": "https://www.sahibinden.com/" },
    { "do": "wait", "selector": "#searchText", "timeout_ms": 8000 },
    { "do": "fill", "selector": "#searchText", "value": "{arama_terimi}" },
    {
      "do": "js_eval",
      "code": "const i=document.querySelector('#searchText'); i.dispatchEvent(new Event('input',{bubbles:true})); i.dispatchEvent(new Event('keyup',{bubbles:true})); document.querySelector('button[value=\"Ara\"]').removeAttribute('disabled'); document.querySelector('button[value=\"Ara\"]').click();"
    },
    { "do": "wait", "selector": "#searchResultsTable", "timeout_ms": 15000 },
    {
      "do": "extract_list",
      "selector": "#searchResultsTable tbody.searchResultsRowClass tr.searchResultsItem",
      "fields": {
        "baslik": "a.classifiedTitle",
        "fiyat": ".searchResultsPriceValue span",
        "tarih": ".searchResultsDateValue span",
        "konum": ".searchResultsLocationValue",
        "url": "a.classifiedTitle @href"
      },
      "as": "ilanlar",
      "limit": 3
    },
    { "do": "notify", "message": "Bulunan ilanlar: {ilanlar}" },
    {
      "do": "foreach",
      "list": "{ilanlar}",
      "as": "ilan",
      "body": [
        { "do": "new_tab", "url": "https://www.sahibinden.com{ilan.url}" },
        { "do": "wait", "selector": ".classifiedDetailThumbListContainer", "timeout_ms": 10000 },
        {
          "do": "extract_list",
          "selector": ".classifiedDetailThumbListContainer .thmbImg",
          "fields": { "foto": "@src" },
          "as": "fotograflar"
        },
        { "do": "notify", "message": "{ilan.baslik} | {ilan.fiyat} | {ilan.konum} | Foto: {fotograflar}" },
        { "do": "close_page" }
      ]
    }
  ]
}